<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Rectangle2D?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mathcat.mathcat.controllers.ProfileController"
            prefHeight="400.0"
            prefWidth="600.0"
            style="-fx-background-color: #303446;">

    <top>
        <VBox alignment="CENTER" spacing="4.0">
            <padding>
                <Insets top="8" bottom="4" />
            </padding>

            <Label text="Profile"
                   style="-fx-font-size: 24px;" />

            <StackPane prefHeight="105.0" prefWidth="170.0">
                <ImageView fx:id="viewCurrentPetImage"
                           fitHeight="130.0"
                           fitWidth="150.0"
                           pickOnBounds="true"
                           preserveRatio="true">
                    <viewport>
                        <Rectangle2D />
                    </viewport>
                    <image>
                        <Image url="@assets/images/sprites/cats/orange-normal.png" />
                    </image>
                </ImageView>

                <ImageView fx:id="viewCurrentAccessoryImage"
                           fitHeight="130.0"
                           fitWidth="150.0"
                           pickOnBounds="true"
                           preserveRatio="true">
                    <viewport>
                        <Rectangle2D />
                    </viewport>
                    <image>
                        <Image url="@assets/images/sprites/accessories/no-accessory-selected.png" />
                    </image>
                </ImageView>
            </StackPane>

            <Label fx:id="levelProgressLabel"
                   text=""
                   style="-fx-font-size: 18px;" />

            <ProgressBar fx:id="levelProgressBar"
                         prefWidth="330.0"
                         progress="0.0" />
        </VBox>
    </top>

    <center>
        <HBox alignment="CENTER" spacing="12.0">
            <padding>
                <Insets top="4" right="10" bottom="4" left="10" />
            </padding>

            <VBox spacing="7.0"
                  prefWidth="280.0"
                  prefHeight="160.0"
                  style="-fx-background-color: #414559; -fx-background-radius: 12; -fx-border-color: #626880; -fx-border-radius: 12; -fx-padding: 10;">

                <Label fx:id="petNameLabel"
                       text="Maisy's Stats"
                       style="-fx-font-size: 18px;" />

                <VBox spacing="2.0">
                    <Label text="Happiness" style="-fx-font-size: 13px;" />
                    <StackPane prefWidth="250.0">
                        <ProgressBar fx:id="happinessProgressBar"
                                     prefWidth="250.0"
                                     progress="0.0" />
                        <Label fx:id="happinessLabel"
                               styleClass="stat-value"
                               text="0" />
                    </StackPane>
                </VBox>

                <VBox spacing="2.0">
                    <Label text="Hunger" style="-fx-font-size: 13px;" />
                    <StackPane prefWidth="250.0">
                        <ProgressBar fx:id="hungerProgressBar"
                                     prefWidth="250.0"
                                     progress="0.0" />
                        <Label fx:id="hungerLabel"
                               styleClass="stat-value"
                               text="0" />
                    </StackPane>
                </VBox>

                <VBox spacing="2.0">
                    <Label text="Energy" style="-fx-font-size: 13px;" />
                    <StackPane prefWidth="250.0">
                        <ProgressBar fx:id="energyProgressBar"
                                     prefWidth="250.0"
                                     progress="0.0" />
                        <Label fx:id="energyLabel"
                               styleClass="stat-value"
                               text="0" />
                    </StackPane>
                </VBox>
            </VBox>

            <VBox spacing="9.0"
                  prefWidth="280.0"
                  prefHeight="160.0"
                  style="-fx-background-color: #414559; -fx-background-radius: 12; -fx-border-color: #626880; -fx-border-radius: 12; -fx-padding: 10;">

                <Label text="Account Information"
                       style="-fx-font-size: 18px;" />

                <GridPane hgap="8.0" vgap="8.0">
                    <columnConstraints>
                        <ColumnConstraints prefWidth="72.0" />
                        <ColumnConstraints prefWidth="112.0" />
                        <ColumnConstraints prefWidth="72.0" />
                    </columnConstraints>

                    <Label text="Username"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 12px;" />

                    <Label fx:id="usernameLabel"
                           text=""
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"
                           style="-fx-font-size: 12px;" />

                    <Button text="Change"
                            GridPane.rowIndex="0"
                            GridPane.columnIndex="2"
                            prefWidth="72.0"
                            prefHeight="25.0"
                            onAction="#onChangeUsername"/>

                    <Label text="Email"
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 12px;" />

                    <Label fx:id="emailLabel"
                           text=""
                           GridPane.rowIndex="1"
                           GridPane.columnIndex="1"
                           style="-fx-font-size: 12px;" />

                    <Button text="Change"
                            GridPane.rowIndex="1"
                            GridPane.columnIndex="2"
                            prefWidth="72.0"
                            prefHeight="25.0"
                            onAction="#onChangeEmail"/>

                    <Label text="Password"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="0"
                           style="-fx-font-size: 12px;" />

                    <PasswordField fx:id="passwordLabel"
                           text="•••"
                           GridPane.rowIndex="2"
                           GridPane.columnIndex="1"
                           style="-fx-font-size: 12px;" />

                    <Button text="Change"
                            GridPane.rowIndex="2"
                            GridPane.columnIndex="2"
                            prefWidth="72.0"
                            prefHeight="25.0"
                            onAction="#onChangePassword"/>
                </GridPane>
            </VBox>
        </HBox>
    </center>

    <bottom>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="4" right="10" bottom="8" left="10" />
            </padding>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Logout"
                        prefWidth="285.0"
                        prefHeight="32.0"
                        onAction="#onLogoutConfirm"/>

                <Button text="Delete Account"
                        prefWidth="285.0"
                        prefHeight="32.0"
                        onAction="#onDeleteAccount"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>