<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="10" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mathcat.mathcat.ChatController"
      prefWidth="400" prefHeight="500">
    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <Label text="💡 Hint Assistant" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
    <Label text="Ask me for hints — I won't give the answer away!"
           style="-fx-font-size: 11; -fx-text-fill: grey;"/>

    <ScrollPane fx:id="scrollPane" VBox.vgrow="ALWAYS" fitToWidth="true">
        <VBox fx:id="chatBox" spacing="8">
            <padding>
                <Insets top="5" right="5" bottom="5" left="5"/>
            </padding>
        </VBox>
    </ScrollPane>

    <HBox spacing="8">
        <TextField fx:id="userInput" promptText="Type your question here..."
                   HBox.hgrow="ALWAYS"/>
        <Button fx:id="sendButton" text="Send" onAction="#onSendClicked"/>
    </HBox>
</VBox>