<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mathcat.mathcat.controllers.ChatController"
            prefWidth="400" prefHeight="500">

    <!-- Top: Title section -->
    <top>
        <VBox spacing="4" style="-fx-padding: 10;">
            <Label text="Chatty" style="-fx-font-size: 16; -fx-font-weight: bold;"/>
            <Label text="Having Troubles?? Ask Me"
                   style="-fx-font-size: 11; -fx-text-fill: grey;"/>
        </VBox>
    </top>

    <!-- Center: Scrollable chat messages -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true">
            <VBox fx:id="chatBox" spacing="8">
                <padding>
                    <Insets top="5" right="5" bottom="5" left="5"/>
                </padding>
            </VBox>
        </ScrollPane>
    </center>

    <!-- Bottom: Input area -->
    <bottom>
        <HBox spacing="8" style="-fx-padding: 8;">
            <TextField fx:id="userInput" promptText="Type your question here..."
                       HBox.hgrow="ALWAYS"/>
            <Button fx:id="sendButton" text="Send" onAction="#onSendClicked"/>
        </HBox>
    </bottom>

</BorderPane>