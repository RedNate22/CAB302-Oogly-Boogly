<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Button?>
<VBox alignment="CENTER" spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mathcat.mathcat.controllers.homeController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>

    <Label fx:id = "idLabel" style="-fx-font-size: 40px; -fx-font-weight: bold;"/>
    <Label fx:id = "usernameLabel" style="-fx-font-size: 40px; -fx-font-weight: bold;"/>
    <Label fx:id = "emailLabel" style="-fx-font-size: 40px; -fx-font-weight: bold;"/>
    <Button text="Logout" onAction="#onLogout"/>

</VBox>