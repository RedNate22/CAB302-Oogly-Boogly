{
	// My OCD...

	// Tells the Java language server where source files live, since the Maven
	// project is in the mathcat/ subdirectory rather than the workspace root.
	"java.project.sourcePaths": [
		"mathcat/src/main/java",
		"mathcat/src/test/java"
	],

	// Disables the Red Hat XML extension's validation for FXML files.
	// Without this, the XML validator produces "Missing controller" warnings
	// because it can't resolve controller paths in the mathcat/ submodule.
	"xml.fileAssociations": [
		{
			"pattern": "**/*.fxml",
			"systemId": ""
		}
	],

	// Disables the Java extension's own FXML controller validation for the
	// same reason as above - it resolves paths from the workspace root rather
	// than the Maven submodule, producing false "Missing controller" warnings.
	"java.jdt.ls.vmargs": "-Declipse.fxml.validate=false"
}
